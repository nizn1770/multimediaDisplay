[Unit]
Description=Pi TV display server
After=network-online.target
Wants=network-online.target
[Service]
User=pi
WorkingDirectory=/home/pi/pi-tv-display
Environment=PITV_CONFIG=/home/pi/pi-tv-display/config.yaml
ExecStart=/home/pi/pi-tv-display/.venv/bin/python -m app.server
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
